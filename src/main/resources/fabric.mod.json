{
	"schemaVersion": 1,
	"id": "omnispell",
	"version": "${version}",
	"name": "Omnispell",
	"description": "Craft your own spells from words of power. Includes the Soul Bind enchantment.",
	"authors": [],
	"license": "MIT",
	"environment": "*",
	"provides": ["soulbind"],
	"entrypoints": {
		"main": [
			"com.soulbind.SoulBind",
			"com.omnispell.Omnispell"
		],
		"client": [
			"com.omnispell.client.OmnispellClient"
		]
	},
	"mixins": [
		"soulbind.mixins.json",
		"omnispell.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.0",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
